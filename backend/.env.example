# 複製成 .env 後修改：cp .env.example .env
# ⚠️ .env 含有機密，已加入 .gitignore，請勿 commit！

# 資料庫：本機預設 SQLite；正式環境用 PostgreSQL / Supabase
DATABASE_URL=sqlite:///./stock.db
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/stock

# 行情來源：yfinance（真實資料）或 demo（離線假資料，沒網路也能跑）
DATA_PROVIDER=yfinance

# 投資組合加總的幣別（TWD / USD / AUD …）
BASE_CURRENCY=TWD

# 允許呼叫 API 的前端網址（JSON 陣列格式）
CORS_ORIGINS=["http://localhost:3000"]

# 排程：每小時第幾分鐘執行；多 worker 部署請設 false 並改用外部 cron
ENABLE_SCHEDULER=true
NEWS_REFRESH_MINUTE=0

# 外部 cron 呼叫 POST /api/jobs/refresh-news 用的密鑰（留空 = 停用此 API）
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# （選用）Claude AI 新聞摘要；留空則使用規則式摘要
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
